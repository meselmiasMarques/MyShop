@using Microsoft.AspNetCore.Components.Authorization
@using MyShop.App.Components.Alerts
@inherits LayoutComponentBase

<div class="page">
   
    <div class="sidebar">
        <NavMenu/>
    </div>
    <Alert />
    <main>
        <AuthorizeView>
            <Authorized>
                <span>Olá @context.User.Identity?.Name</span>
                <a href="/logout" class="btn btn-sm btn-danger">Sair</a>
            </Authorized>
            <NotAuthorized>
                <a href="/login" class="btn btn-sm btn-primary">Login</a>
                <a href="/register" class="btn btn-sm btn-success">Registrar</a>
            </NotAuthorized>
        </AuthorizeView>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>


