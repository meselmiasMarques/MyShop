@page "/categorias"


<div>
    <button class="btn btn-primary" @onclick="NewCategory" >Nova Categoria</button>
</div>
<div class="container-fluid">
    <table class="table">
        <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Titulo</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var category in Categories)
        {
            <tr>
                <th scope="row">@category.Id</th>
                <td>@category.Title</td>
            </tr>
        }
        </tbody>
    </table>
</div>