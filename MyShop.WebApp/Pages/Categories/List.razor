@page "/categorias"
@using Microsoft.AspNetCore.Authorization
@using MyShop.App.Components
@attribute [Authorize]
<div>
    <button class="btn btn-primary" @onclick="NewCategory" >Nova Categoria</button>
</div>
<div class="container-fluid">
    <table class="table">
        <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Titulo</th>
            <th scope="col">#</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var category in Categories)
        {
            <tr>
                <th scope="row">@category.Id</th>
                <td>@category.Title</td>
                <td>
                    <button class="btn btn-info"
                            @onclick="() => Edit(category.Id)">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                
                    <button class="btn btn-primary"
                            @onclick="() => Delete(category.Id)">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<ConfirmModal @ref="confirmModal"
              Title="Excluir Categoria"
              Message="Tem certeza que deseja excluir essa categoria?"
              OnClose="HandleConfirmation" />